        <l2-dhcpv4-relay-profile>
          <name>dhcpv4_relay_profile</name>
          <option82-format>
            <suboptions>circuit-id</suboptions>
            <default-circuit-id-syntax>Access-Node-ID eth Board/Pon/OnuID/OnuPort/OnuSN</default-circuit-id-syntax>
          </option82-format>
          <option82-format>
            <suboptions>remote-id</suboptions>
            <default-remote-id-syntax>Access-Node-ID eth Board/Pon/OnuID/OnuPort/OnuSN</default-remote-id-syntax>
          </option82-format>
        </l2-dhcpv4-relay-profile>
      </l2-dhcpv4-relay-profiles>
